import pandas as pd
import os
import warnings
warnings.filterwarnings('ignore', category=UserWarning, module='openpyxl')

# Fix para planillas con formatos condicionales complejos (MultiCellRange inválido)
try:
    from openpyxl.worksheet.cell_range import MultiCellRange
    _orig_mcr_init = MultiCellRange.__init__
    def _safe_mcr_init(self, ranges=''):
        try: _orig_mcr_init(self, ranges)
        except Exception: _orig_mcr_init(self, '')
    MultiCellRange.__init__ = _safe_mcr_init
except Exception:
    pass

# Fix congelamiento conditional formatting
try:
    import openpyxl.worksheet._reader as _opr
    _orig_bind = _opr.WorksheetReader.bind_formatting
    def _safe_bind(self, *args, **kwargs):
        try: return _orig_bind(self, *args, **kwargs)
        except Exception: pass
    _opr.WorksheetReader.bind_formatting = _safe_bind
except Exception:
    pass

# --- CONFIGURACIÓN DE RUTAS ---
ruta_input = r'E:\Proyecto_Data\Test_EXTINCION\input'

HOJA = 'Resumen Costo-Venta'


def extraer_numero(valor):
    try:
        if pd.isna(valor): return None
        return float(valor)
    except (TypeError, ValueError): return None


def normalizar_fecha(valor):
    if valor is None or (isinstance(valor, float) and pd.isna(valor)): return None
    if hasattr(valor, 'strftime'): return valor.strftime('%d-%m-%Y')
    return str(valor)


def buscar(df, texto, d_f=0, d_c=0, exacto=True):
    """Busca texto en la hoja y retorna celda con offset."""
    if exacto:
        mascara = df.apply(lambda col: col.map(
            lambda x: str(x).strip().lower() == texto.strip().lower()))
    else:
        mascara = df.apply(lambda col: col.map(
            lambda x: texto.strip().lower() in str(x).strip().lower()))
    pos = mascara.stack()[mascara.stack()].index.tolist()
    if pos:
        f, c = pos[0]
        return df.iloc[f + d_f, c + d_c]
    return None


def procesar_extincion():
    if not os.path.exists(ruta_input):
        print(f"⚠️ Carpeta no encontrada: {ruta_input}")
        return None

    archivos = [f for f in os.listdir(ruta_input)
                if f.endswith('.xlsx') and not f.startswith('~$')]
    print(f"📊 Archivos encontrados: {len(archivos)}")

    lista_maestra = []

    for archivo in archivos:
        id_proyecto = os.path.splitext(archivo)[0]
        ruta_completa = os.path.join(ruta_input, archivo)

        try:
            df = pd.read_excel(ruta_completa, sheet_name=HOJA, header=None)

            # ── 1. IDENTIFICACIÓN ──────────────────────────────────────────
            nombre_val = None
            mask_nombre = df.apply(lambda col: col.map(
                lambda x: str(x).strip().lower() == 'nombre proyecto:'))
            pos_nombre = mask_nombre.stack()[mask_nombre.stack()].index.tolist()
            if pos_nombre:
                f_n, c_n = pos_nombre[0]
                # Buscar nombre real en offsets +1, +2, +3 — ignorar 'OBRA TIPO' y valores cortos
                for dc_n in [2, 1, 3]:
                    try:
                        v_n = df.iloc[f_n, c_n + dc_n]
                        if (v_n is not None and str(v_n).strip() not in ('','nan','OBRA TIPO')
                                and len(str(v_n).strip()) > 3):
                            nombre_val = v_n
                            break
                    except: pass

            fecha_val = None
            mask_fecha = df.apply(lambda col: col.map(
                lambda x: str(x).strip().lower() == 'fecha:'))
            pos_fecha = mask_fecha.stack()[mask_fecha.stack()].index.tolist()
            if pos_fecha:
                f_f, c_f = pos_fecha[0]
                fecha_val = normalizar_fecha(df.iloc[f_f, c_f + 2])

            # ── 2. MONEDAS (anchor: 'FECHA' en bloque monedas) ────────────
            # UF en (0,-1), USD en (+1,-1), EURO en (+2,-1)
            # Fecha moneda en (0,+1), Duración en (+1,+2)
            valor_uf = valor_usd = valor_euro = None
            fecha_moneda = duracion_val = None

            mask_mon = df.apply(lambda col: col.map(
                lambda x: str(x).strip().upper() == 'FECHA'))
            pos_mon = mask_mon.stack()[mask_mon.stack()].index.tolist()

            # Validar que es el bloque de monedas: debe tener 'UF' en offset(-1,-1)
            for f_m, c_m in pos_mon:
                try:
                    # UF puede estar en offset(+1,-2) o (+1,-3) según planilla
                    for dc_uf in [-2, -3, -1]:
                        try:
                            if str(df.iloc[f_m + 1, c_m + dc_uf]).strip().upper() == 'UF':
                                # Valor puede estar en +1 o +2 desde el label UF
                                for dc_val in [1, 2]:
                                    v_uf = extraer_numero(df.iloc[f_m + 1, c_m + dc_uf + dc_val])
                                    if v_uf is not None and v_uf > 0:
                                        valor_uf  = v_uf
                                        valor_usd = extraer_numero(df.iloc[f_m + 2, c_m + dc_uf + dc_val])
                                        valor_euro= extraer_numero(df.iloc[f_m + 3, c_m + dc_uf + dc_val])
                                        break
                                fecha_moneda = normalizar_fecha(df.iloc[f_m + 1, c_m])
                                duracion_val = extraer_numero(df.iloc[f_m + 2, c_m + 1])
                                break
                        except: pass
                    if valor_uf: break
                except IndexError:
                    continue

            # ── 3. ÁREA ────────────────────────────────────────────────────
            mts_acond = extraer_numero(buscar(df, 'AREA ACONDICIONADA M2', 0, 1))
            mts_total = extraer_numero(buscar(df, 'AREA TOTAL M2', 0, -1))

            # ── 4. VENTA / MARGEN ──────────────────────────────────────────
            # Venta — buscar primer número válido en la fila (offset variable)
            def buscar_valor_fila(texto_anchor):
                mask_a = df.apply(lambda col: col.map(
                    lambda x: texto_anchor.lower() in str(x).strip().lower()))
                pos_a = mask_a.stack()[mask_a.stack()].index.tolist()
                if not pos_a: return None
                f_a, c_a = pos_a[0]
                for dc in range(1, 12):
                    try:
                        v = extraer_numero(df.iloc[f_a, c_a + dc])
                        if v is not None and v != 0:
                            return v
                    except: pass
                return None

            venta_clp_val = buscar_valor_fila('TOTAL VENTA $$')
            venta_uf_val  = buscar_valor_fila('TOTAL VENTA UF')
            margen_val    = buscar_valor_fila('MARGEN REAL VENTA (MATERIALES + EQUIPOS)')
            # Filtrar margenes fuera de rango (planillas sin datos reales)
            if margen_val is not None and (margen_val <= 0 or margen_val >= 1):
                margen_val = None

            # ── 5. TABLA RESUMEN (anchor: 'Materiales' con 'Importado' al lado) ──
            # fila headers: Materiales(0,0) | Importado(0,+1) | MOD(0,+2) |
            #               MOI(0,+3) | GG(0,+4) | Costo(0,+5)
            # fila valores: offset(+1, ...)
            mat_val = eq_val = mod_val = moi_val = gg_val = costo_val = hh_val = None

            mask_mat = df.apply(lambda col: col.map(
                lambda x: str(x).strip().lower() == 'materiales'))
            pos_mat = mask_mat.stack()[mask_mat.stack()].index.tolist()

            pos_mat_valida = None
            for f_m, c_m in pos_mat:
                try:
                    # Importado puede estar en offset +1 o +2
                    for dc_imp in [1, 2]:
                        if str(df.iloc[f_m, c_m + dc_imp]).strip().lower() == 'importado':
                            pos_mat_valida = (f_m, c_m)
                            break
                    if pos_mat_valida:
                        break
                except IndexError:
                    continue

            if pos_mat_valida:
                f_m, c_m = pos_mat_valida
                # Buscar offset de Importado para ajustar columnas
                dc_imp = 1
                for dc_test in [1, 2]:
                    try:
                        if str(df.iloc[f_m, c_m + dc_test]).strip().lower() == 'importado':
                            dc_imp = dc_test
                            break
                    except: pass
                mat_val   = extraer_numero(df.iloc[f_m + 1, c_m])
                eq_val    = extraer_numero(df.iloc[f_m + 1, c_m + dc_imp])
                mod_val   = extraer_numero(df.iloc[f_m + 1, c_m + dc_imp + 1])
                moi_val   = extraer_numero(df.iloc[f_m + 1, c_m + dc_imp + 2])
                gg_val    = extraer_numero(df.iloc[f_m + 1, c_m + dc_imp + 3])
                costo_val = extraer_numero(df.iloc[f_m + 1, c_m + dc_imp + 4])
                hh_col    = c_m + dc_imp + 8
                hh_val    = extraer_numero(df.iloc[f_m + 1, hh_col]) if hh_col < df.shape[1] else None

            # ── 6. ARMAR REGISTRO ──────────────────────────────────────────
            registro = {
                'ID':               id_proyecto,
                'Proyecto':         nombre_val,
                'Fecha':            fecha_val,
                'Fecha_Moneda':     fecha_moneda,
                'Valor_UF':         valor_uf,
                'Valor_USD':        valor_usd,
                'Valor_EURO':       valor_euro,
                'Duracion_Meses':   duracion_val,
                'MTS_Acondicionada': mts_acond,
                'MTS_Total':        mts_total,
                'Venta_CLP':        venta_clp_val,
                'Venta_UF':         venta_uf_val,
                'Margen':           margen_val,
                'MAT':              mat_val,
                'EQ':               eq_val,
                'MOD':              mod_val,
                'MOI':              moi_val,
                'GG':               gg_val,
                'Costo_Total':      costo_val,
                'HH':               hh_val,
            }

            lista_maestra.append(pd.DataFrame([registro]))
            print(f"✅ Procesado: {id_proyecto}")

        except Exception as e:
            print(f"❌ Error en {archivo}: {e}")

    if not lista_maestra:
        return None

    return pd.concat(lista_maestra, ignore_index=True)


if __name__ == "__main__":
    resultado = procesar_extincion()
    if resultado is not None:
        print(f"\n--- Proceso terminado ---")
        print(f"Filas: {len(resultado)} | Columnas: {len(resultado.columns)}")
        print("\nMissing values por columna:")
        print(resultado.isnull().sum())
